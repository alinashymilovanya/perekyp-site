# Never commit the real token. Copy this file to .env locally.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MINIMUM_MARGIN_RUB=500
DELIVERY_RUB=400
COMMISSION_RUB=0
REPAIR_RESERVE_USED_RUB=1500
REPAIR_RESERVE_BROKEN_RUB=10000
BROWSER_ACT_PATH=browser-act
AVITO_SESSION_NAME=avito-check
AVITO_SEARCH_URL=https://www.avito.ru/all/telefony/mobilnye_telefony/apple-ASgBAgICAkS0wA3OqzmwwQ2I_Dc
DATABASE_PATH=data/seen.sqlite3
POLL_INTERVAL_SECONDS=60

# Keep disabled until you connect a permitted data provider.
LISTINGS_SOURCE=disabled
LISTINGS_SOURCE_URL=
LISTINGS_SOURCE_TOKEN=

# Health and recovery. Do not lower retry values just to force a blocked source.
STATUS_PATH=data/runtime-status.json
SOURCE_RETRY_BASE_SECONDS=60
SOURCE_RETRY_MAX_SECONDS=1800
SOURCE_ALERT_AFTER_SECONDS=900
BACKUP_DIRECTORY=data/backups

# Daily report schedule in the selected IANA timezone.
DAILY_SUMMARY_TIME=20:00
SUMMARY_TIMEZONE=Europe/Astrakhan
