# Шаблон настроек. Скопируйте в .env и заполните секреты. .env в git не попадает.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Можно оставить пустым: бот запомнит того, кто первым отправит /start.
TELEGRAM_CHAT_ID=
# botapi — обычный Bot API (работает на сервере за пределами РФ).
# mtproto — через MTProto-прокси, нужен, если Bot API блокируется провайдером.
TELEGRAM_TRANSPORT=botapi
# Только для mtproto: host:port:secret или ссылка t.me/proxy?server=..
TELEGRAM_PROXY=
TELEGRAM_API_ID=2040
TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627
TELEGRAM_SESSION_PATH=data/bot_mtproto

# --- Экономика сделки (в рублях) ---
MINIMUM_MARGIN_RUB=500
# Ниже этой маржи уведомления не отправляются вообще.
# 500 — как сейчас в рабочем .env: приходят все сделки от 500 ₽ маржи.
NOTIFY_MIN_MARGIN_RUB=500
DELIVERY_RUB=400
COMMISSION_RUB=0
REPAIR_RESERVE_USED_RUB=1500
REPAIR_RESERVE_BROKEN_RUB=10000

# --- Источник объявлений ---
# avito_api — встроенный адаптер к ленте Авито (без браузера и прокси).
# browser — BrowserAct (только Windows), vision / json_api — внешние сервисы.
LISTINGS_SOURCE=avito_api
# 107620 — вся Россия. Другие города: Москва 637640, СПб 653240, Новосибирск 641780.
AVITO_API_LOCATION_ID=107620
# Авито игнорирует фразу в этой ленте, фильтр по iPhone идёт по названию объявления.
AVITO_API_QUERY=
AVITO_API_PAGES=1
AVITO_API_SORT=date
# Не опускайте ниже 180: Авито отвечает 429 и блокирует IP на несколько минут.
POLL_INTERVAL_SECONDS=600
MAX_LISTINGS_PER_POLL=50

# --- Прочие источники (если LISTINGS_SOURCE выбран другой) ---
BROWSER_ACT_PATH=browser-act
AVITO_BROWSER_ID=
AVITO_SESSION_NAME=avito-check
AVITO_SEARCH_URL=
LISTINGS_SOURCE_URL=
LISTINGS_SOURCE_TOKEN=
VISION_API_TOKEN=
VISION_FOLDER_ID=
VISION_PROFILE_ID=
VISION_NODE_PATH=node
VISION_PLAYWRIGHT_PATH=playwright

# --- Хранение и журналы ---
DATABASE_PATH=data/seen.sqlite3
STATUS_PATH=data/runtime-status.json
LOG_PATH=data/bot.log

# --- Повторы и оповещения о сбоях источника ---
SOURCE_RETRY_BASE_SECONDS=60
SOURCE_RETRY_MAX_SECONDS=1800
SOURCE_ALERT_AFTER_SECONDS=900
HEALTH_MAX_AGE_SECONDS=600

# --- Ежедневная сводка ---
DAILY_SUMMARY_TIME=20:00
SUMMARY_TIMEZONE=Europe/Astrakhan

# --- Публикация данных на сайт (необязательно) ---
SITE_EXPORT_PATH=data/site-data.json
SITE_EXPORT_INTERVAL_SECONDS=1800
# Способ 1 (рекомендуется): коммит снимка в репозиторий, откуда его забирает
# GitHub Actions и выкладывает на хостинг. Нужен токен с правом записи в repo.
GITHUB_TOKEN=
GITHUB_REPO=alinashymilovanya/perekyp-site
GITHUB_SITE_PATH=site/site-data.json
GITHUB_BRANCH=master
# Способ 2: прямая загрузка по FTP.
SITE_FTP_HOST=
SITE_FTP_USER=
SITE_FTP_PASSWORD=
SITE_FTP_DIR=/htdocs
